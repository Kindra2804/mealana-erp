<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: DejaVu Sans, sans-serif;
      font-size: 9pt;
      color: #1a1a1a;
      padding: 18mm 15mm 30mm 15mm;
    }
    .adressblock-absender {
      font-size: 7pt;
      color: #555;
      border-bottom: 0.5px solid #aaa;
      padding-bottom: 2pt;
      margin-bottom: 3pt;
    }
    .info-raster td {
      padding: 2pt 5pt;
      font-size: 8.5pt;
      vertical-align: top;
    }
    .info-raster td:first-child {
      color: #555;
      white-space: nowrap;
    }
    .info-raster td:last-child {
      font-weight: bold;
    }
    .doc-titel {
      font-size: 16pt;
      font-weight: bold;
      margin: 10pt 0 4pt;
    }
    .lieferadr {
      font-size: 8pt;
      color: #444;
      margin-bottom: 8pt;
    }
    .zahlungshinweis {
      margin-top: 10pt;
      font-size: 8.5pt;
      line-height: 1.6;
    }
    .dankessatz {
      margin-top: 8pt;
      font-size: 8.5pt;
    }
  </style>
</head>
<body>

  {# ── Header ── #}
  {% include '_partials/_header.html.twig' %}

  {# ── Adress- + Info-Block ── #}
  <table style="width:100%; border-collapse:collapse; margin-top:10pt;">
    <tr>
      {# Links: Empfänger-Fenster #}
      <td style="width:50%; vertical-align:top; padding-right:10pt;">
        <div class="adressblock-absender">
          {{ firma.firmenname ?? 'MEALANA KG' }} &middot;
          {{ firma.strasse ?? '' }} &middot;
          {{ firma.plz ?? '' }} {{ firma.ort ?? '' }}
        </div>
        {% set adr = rechnungadr|length ? rechnungadr : kunde %}
        {% if adr.anrede is defined %}<strong>{{ adr.anrede }}</strong><br>{% endif %}
        {% if adr.firmenname is defined and adr.firmenname %}
          <strong>{{ adr.firmenname }}</strong><br>
        {% endif %}
        {{ adr.vorname ?? '' }} {{ adr.nachname ?? (kunde.name ?? '') }}<br>
        {{ adr.strasse ?? '' }}<br>
        {{ adr.plz ?? '' }} {{ adr.ort ?? '' }}<br>
        {% if adr.land is defined and adr.land and adr.land != 'AT' %}
          {{ adr.land }}<br>
        {% endif %}
      </td>

      {# Rechts: Info-Raster #}
      <td style="width:50%; vertical-align:top;">
        <table class="info-raster" style="width:100%; border:1px solid #ccc; border-collapse:collapse;">
          <tr style="background:#f5f5f5;">
            <td style="border-bottom:1px solid #ccc;">Rechnungs-Nr.:</td>
            <td style="border-bottom:1px solid #ccc;">{{ rechnung.nr }}</td>
          </tr>
          <tr>
            <td style="border-bottom:1px solid #ccc;">Rechnungsdatum:</td>
            <td style="border-bottom:1px solid #ccc;">{{ rechnung.datum }}</td>
          </tr>
          <tr>
            <td style="border-bottom:1px solid #ccc;">Liefer-/Leistungsdatum:</td>
            <td style="border-bottom:1px solid #ccc;">{{ rechnung.leistungsdatum ?? rechnung.datum }}</td>
          </tr>
          <tr style="background:#f5f5f5;">
            <td style="border-bottom:1px solid #ccc;">Auftrags-Nr.:</td>
            <td style="border-bottom:1px solid #ccc;">{{ auftrag.auftrag_nr }}</td>
          </tr>
          <tr>
            <td style="border-bottom:1px solid #ccc;">Bestelldatum:</td>
            <td style="border-bottom:1px solid #ccc;">
              {{ auftrag.erstellt_am ? auftrag.erstellt_am|date('d.m.Y') : datum_heute }}
            </td>
          </tr>
          {% if auftrag.kunden_id %}
          <tr>
            <td style="border-bottom:1px solid #ccc;">Kunden-Nr.:</td>
            <td style="border-bottom:1px solid #ccc;">{{ auftrag.kunden_id }}</td>
          </tr>
          {% endif %}
          <tr>
            <td style="border-bottom:1px solid #ccc;">Zahlungsart:</td>
            <td style="border-bottom:1px solid #ccc;">
              {% set zahlungsarten = {
                'vorkasse': 'Vorkasse', 'paypal': 'PayPal',
                'bar': 'Barzahlung', 'rechnung': 'Rechnung',
                'gutschein': 'Gutschein', 'gemischt': 'Gemischt'
              } %}
              {{ zahlungsarten[auftrag.zahlungsart] ?? auftrag.zahlungsart }}
            </td>
          </tr>
          <tr>
            <td style="border-bottom:1px solid #ccc;">Versandart:</td>
            <td style="border-bottom:1px solid #ccc;">
              {% if auftrag.kanal == 'haendler' %}Kommissionsware (Verkaufsmeldung){% else %}{{ auftrag.lieferart == 'abholung' ? 'Selbstabholung' : 'Versand' }}{% endif %}
            </td>
          </tr>
          {% if auftrag.bearbeiter_name %}
          <tr>
            <td>Bearbeiter:</td>
            <td>{{ auftrag.bearbeiter_name }}</td>
          </tr>
          {% endif %}
        </table>
      </td>
    </tr>
  </table>

  {# ── Dokumenttitel ── #}
  <div class="doc-titel">{{ rechnung.ist_teilrechnung ? 'Teilrechnung' : 'Rechnung' }}</div>

  {# ── Lieferanschrift (wenn abweichend) ── #}
  {% if lieferadr|length %}
    <div class="lieferadr">
      Lieferanschrift:
      {{ lieferadr.vorname ?? '' }} {{ lieferadr.nachname ?? '' }},
      {{ lieferadr.strasse ?? '' }},
      {{ lieferadr.plz ?? '' }} {{ lieferadr.ort ?? '' }}
      {% if lieferadr.land is defined and lieferadr.land and lieferadr.land != 'AT' %}, {{ lieferadr.land }}{% endif %}
    </div>
  {% endif %}

  {# ── Positionen ── #}
  {% include '_partials/_positionen.html.twig' %}

  {# ── Steuerblock + Gesamtbetrag ── #}
  {% include '_partials/_steuerblock.html.twig' %}

  {# ── Teilrechnung: noch nicht gelieferte Artikel (ohne Preise, folgen mit eigener Rechnung) ── #}
  {% if rechnung.ausstaendig is defined and rechnung.ausstaendig|length > 0 %}
    <div style="margin-top:10pt; font-size:8.5pt;">
      <strong>Noch ausständig</strong> — wird nachgeliefert und gesondert verrechnet:
      <table style="width:100%; border-collapse:collapse; margin-top:3pt; font-size:8pt; color:#444;">
        {% for a in rechnung.ausstaendig %}
          <tr style="border-bottom:0.5px solid #eee;">
            <td style="width:30pt; padding:2pt 4pt; text-align:right;">{{ a.menge }}</td>
            <td style="width:60pt; padding:2pt 4pt;">{{ a.artikelnummer }}</td>
            <td style="padding:2pt 4pt;">{{ a.bezeichnung }}</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}

  {# ── Zahlungsinfo: Zahlungen zum Auftrag, Anteil dieser Rechnung, offener Betrag ── #}
  {% if zahlungsinfo is defined and zahlungsinfo.zahlungen|length > 0 %}
    <table style="width:100%; border-collapse:collapse; margin-top:8pt; font-size:8.5pt;">
      <tr>
        <td style="width:40%;"></td>
        <td style="width:60%;">
          <div style="font-weight:bold; margin-bottom:2pt;">Zahlungen zu Auftrag {{ auftrag.auftrag_nr }}</div>
          <table style="width:100%; border-collapse:collapse;">
            {% for z in zahlungsinfo.zahlungen %}
              <tr>
                <td style="padding:1pt 0;">{{ z.datum }} &nbsp; {{ z.text }}</td>
                <td style="padding:1pt 0; text-align:right; white-space:nowrap;">{{ z.betrag|euroformat }} EUR</td>
              </tr>
            {% endfor %}
            {% if rechnung.ist_teilrechnung %}
              <tr>
                <td style="padding:2pt 0; border-top:0.5px solid #999;">Davon auf diese Rechnung angerechnet:</td>
                <td style="padding:2pt 0; border-top:0.5px solid #999; text-align:right;">{{ zahlungsinfo.angerechnet|euroformat }} EUR</td>
              </tr>
            {% endif %}
            <tr>
              <td style="padding:2pt 0; font-weight:bold; {{ rechnung.ist_teilrechnung ? '' : 'border-top:0.5px solid #999;' }}">Offener Betrag:</td>
              <td style="padding:2pt 0; font-weight:bold; text-align:right; {{ rechnung.ist_teilrechnung ? '' : 'border-top:0.5px solid #999;' }}">{{ zahlungsinfo.offen|euroformat }} EUR</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  {% endif %}

  {# ── Zahlungshinweis ── #}
  <div class="zahlungshinweis">
    <strong>Zahlungsart:</strong> {{ zahlungsarten[auftrag.zahlungsart] ?? auftrag.zahlungsart }}&emsp;
    {% if zahlungsinfo is defined and zahlungsinfo.offen <= 0.004 %}
      <strong>Bereits bezahlt — vielen Dank!</strong>
    {% else %}
      <strong>Zahlungsziel:</strong> {{ rechnung.faellig }}{% if rechnung.faellig_text %} ({{ rechnung.faellig_text }}){% endif %}
      {% if auftrag.lieferart == 'abholung' and auftrag.kanal != 'haendler' %}
        <br>Bei Selbstabholung Bezahlung in Bar oder Bankomat möglich.
        Bitte um vorherige Terminvereinbarung!
      {% endif %}
    {% endif %}
  </div>

  <div class="dankessatz">Vielen Dank für Ihre Bestellung!</div>

  {# ── Seiten-Footer (fixiert) ── #}
  {% include '_partials/_footer.html.twig' %}

</body>
</html>
