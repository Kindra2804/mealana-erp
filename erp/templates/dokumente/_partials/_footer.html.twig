{#
  _footer.html.twig
  Seitenfuß mit Firmen-Pflichtangaben (AT UStG §11):
  Name, Adresse, UID, Steuernummer, Bankverbindung.
  Leere Angaben werden weggelassen (z.B. Partner ohne UID, Migration 237).
#}
<div style="position:fixed; bottom:0; left:0; right:0;
            border-top:1px solid #333; padding-top:4pt;
            font-size:7.5pt; color:#333; line-height:1.5;">
  <table style="width:100%; border-collapse:collapse;">
    <tr>
      <td style="width:33%;">
        <strong>{{ firma.firmenname ?? 'MEALANA KG' }}</strong><br>
        {{ firma.strasse ?? '' }}<br>
        {{ firma.plz ?? '' }} {{ firma.ort ?? '' }}<br>
        {{ firma.land ?? 'Österreich' }}
      </td>
      <td style="width:33%;">
        {% if firma.telefon ?? false %}Telefon: {{ firma.telefon }}<br>{% endif %}
        {% if firma.fax is defined and firma.fax %}Telefax: {{ firma.fax }}<br>{% endif %}
        {% if firma.email ?? false %}E-Mail: {{ firma.email }}<br>{% endif %}
        {% if firma.website ?? false %}Internet: {{ firma.website }}{% endif %}
      </td>
      <td style="width:34%;">
        {% if firma.uid_nummer ?? false %}UID: {{ firma.uid_nummer }}<br>{% endif %}
        {% if firma.steuernummer ?? false %}StNr: {{ firma.steuernummer }}<br>{% endif %}
        {% if firma.bank_name ?? false %}{{ firma.bank_name }}<br>{% endif %}
        {% if firma.iban ?? false %}IBAN: {{ firma.iban }}<br>{% endif %}
        {% if firma.bic ?? false %}BIC: {{ firma.bic }}{% endif %}
      </td>
    </tr>
  </table>
</div>
