<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: DejaVu Sans, sans-serif;
      font-size: 9pt;
      color: #1a1a1a;
      padding: 18mm 15mm 30mm 15mm;
    }
    .adressblock-absender {
      font-size: 7pt;
      color: #555;
      border-bottom: 0.5px solid #aaa;
      padding-bottom: 2pt;
      margin-bottom: 3pt;
    }
    .info-raster td { padding: 2pt 5pt; font-size: 8.5pt; vertical-align: top; border-bottom: 1px solid #ccc; }
    .info-raster td:first-child { color: #555; white-space: nowrap; }
    .info-raster td:last-child { font-weight: bold; }
    .doc-titel { font-size: 16pt; font-weight: bold; margin: 14pt 0 10pt; }
    .text { font-size: 9pt; line-height: 1.6; margin-bottom: 10pt; }
    .betraege { width: 60%; border-collapse: collapse; margin: 6pt 0 12pt; }
    .betraege td { padding: 3pt 6pt; font-size: 9pt; border-bottom: 0.5px solid #ddd; }
    .betraege td.r { text-align: right; white-space: nowrap; }
    .betraege tr.summe td { font-weight: bold; border-top: 1px solid #333; border-bottom: none; font-size: 10pt; }
  </style>
</head>
<body>

  {% include '_partials/_header.html.twig' %}

  <table style="width:100%; border-collapse:collapse; margin-top:10pt;">
    <tr>
      <td style="width:50%; vertical-align:top; padding-right:10pt;">
        <div class="adressblock-absender">
          {{ firma.firmenname ?? 'MEALANA KG' }} &middot;
          {{ firma.strasse ?? '' }} &middot;
          {{ firma.plz ?? '' }} {{ firma.ort ?? '' }}
        </div>
        {% set adr = rechnungadr|length ? rechnungadr : kunde %}
        {% if adr.anrede is defined %}<strong>{{ adr.anrede }}</strong><br>{% endif %}
        {% if adr.firmenname is defined and adr.firmenname %}
          <strong>{{ adr.firmenname }}</strong><br>
        {% endif %}
        {{ adr.vorname ?? '' }} {{ adr.nachname ?? (kunde.name ?? '') }}<br>
        {{ adr.strasse ?? '' }}<br>
        {{ adr.plz ?? '' }} {{ adr.ort ?? '' }}<br>
        {% if adr.land is defined and adr.land and adr.land != 'AT' %}
          {{ adr.land }}<br>
        {% endif %}
      </td>
      <td style="width:50%; vertical-align:top;">
        <table class="info-raster" style="width:100%; border:1px solid #ccc; border-collapse:collapse;">
          <tr style="background:#f5f5f5;"><td>Datum:</td><td>{{ datum_heute }}</td></tr>
          <tr><td>Rechnungs-Nr.:</td><td>{{ rechnung.nr }}</td></tr>
          <tr><td>Rechnungsdatum:</td><td>{{ rechnung.datum }}</td></tr>
          <tr><td>Fällig seit:</td><td>{{ rechnung.faellig }}</td></tr>
          <tr style="background:#f5f5f5;"><td>Auftrags-Nr.:</td><td>{{ auftrag.auftrag_nr }}</td></tr>
          {% if auftrag.kunden_id %}
          <tr><td>Kunden-Nr.:</td><td>{{ auftrag.kunden_id }}</td></tr>
          {% endif %}
        </table>
      </td>
    </tr>
  </table>

  <div class="doc-titel">{{ mahnung.titel }}</div>

  {% set name = (adr.vorname ?? '') ~ ' ' ~ (adr.nachname ?? '') %}
  <div class="text">
    {% if name|trim %}Sehr geehrte/r {{ name|trim }},{% else %}Sehr geehrte Damen und Herren,{% endif %}
  </div>

  <div class="text">
    {% if mahnung.stufe == 2 %}
      leider konnten wir trotz unserer Zahlungserinnerung und 1. Mahnung noch keinen Zahlungseingang
      zur oben genannten Rechnung feststellen. Wir bitten Sie dringend, den offenen Betrag
      bis spätestens <strong>{{ mahnung.neue_frist }}</strong> zu überweisen.
    {% else %}
      zu der oben genannten Rechnung konnten wir trotz unserer Zahlungserinnerung noch keinen
      vollständigen Zahlungseingang feststellen. Bitte überweisen Sie den offenen Betrag
      bis <strong>{{ mahnung.neue_frist }}</strong>.
    {% endif %}
  </div>

  <table class="betraege">
    <tr><td>Rechnungsbetrag</td><td class="r">€ {{ rechnung.brutto|number_format(2, ',', '.') }}</td></tr>
    {% if mahnung.offen_betrag < rechnung.brutto - 0.004 %}
    <tr><td>bereits bezahlt</td><td class="r">− € {{ (rechnung.brutto - mahnung.offen_betrag)|number_format(2, ',', '.') }}</td></tr>
    {% endif %}
    {% if mahnung.gebuehren_vorher > 0 %}
    <tr><td>Mahngebühr aus vorheriger Mahnung</td><td class="r">€ {{ mahnung.gebuehren_vorher|number_format(2, ',', '.') }}</td></tr>
    {% endif %}
    {% if mahnung.gebuehr > 0 %}
    <tr><td>Mahngebühr {{ mahnung.titel }}</td><td class="r">€ {{ mahnung.gebuehr|number_format(2, ',', '.') }}</td></tr>
    {% endif %}
    <tr class="summe"><td>Zu zahlen</td><td class="r">€ {{ mahnung.gesamt|number_format(2, ',', '.') }}</td></tr>
  </table>

  <div class="text">
    Bitte geben Sie bei der Überweisung die Rechnungsnummer <strong>{{ rechnung.nr }}</strong> an.
    Bankverbindung: {{ firma.bank_name ?? '' }}, IBAN {{ firma.iban ?? '' }}, BIC {{ firma.bic ?? '' }}.
  </div>

  <div class="text">
    {% if mahnung.stufe == 2 %}
      Sollte bis zu diesem Termin keine Zahlung eingehen, müssen wir weitere Schritte einleiten.
    {% endif %}
    Falls Sie die Zahlung inzwischen veranlasst haben, betrachten Sie dieses Schreiben bitte als gegenstandslos.
  </div>

  <div class="text">Mit freundlichen Grüßen<br>{{ shop.name ?? firma.firmenname ?? 'MEALANA KG' }}</div>

  {% include '_partials/_footer.html.twig' %}

</body>
</html>
